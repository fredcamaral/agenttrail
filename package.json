{
  "name": "agenttrail",
  "version": "0.2.0",
  "description": "Live map of every coding-agent session on your machine: status, current tool, subagent tree, cost — read straight from the transcripts. One local daemon, no database, no dependencies.",
  "type": "module",
  "bin": {
    "agenttrail": "bin/agenttrail.mjs"
  },
  "scripts": {
    "test": "node --test 'test/*.test.mjs'"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "files": [
    "bin",
    "lib",
    "public"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fredcamaral/agenttrail.git"
  },
  "homepage": "https://github.com/fredcamaral/agenttrail#readme",
  "keywords": [
    "claude-code",
    "coding-agents",
    "ai-agents",
    "agent-observability",
    "agent-monitoring",
    "session-monitor",
    "subagents",
    "transcripts",
    "live-dashboard",
    "local-first",
    "sse",
    "no-dependencies"
  ]
}
